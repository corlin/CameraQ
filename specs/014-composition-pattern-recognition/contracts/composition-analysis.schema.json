{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cameraq.local/contracts/composition-analysis.schema.json",
  "title": "CameraQ Composition Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_version",
    "timestamp",
    "frame_width",
    "frame_height",
    "evidence_quality",
    "mode_results",
    "top_modes",
    "recommendation",
    "insufficient_evidence",
    "processing_time_ms"
  ],
  "properties": {
    "analysis_version": { "const": "1.0" },
    "timestamp": { "type": "number", "minimum": 0 },
    "frame_width": { "type": "integer", "minimum": 1 },
    "frame_height": { "type": "integer", "minimum": 1 },
    "evidence_quality": { "type": "number", "minimum": 0, "maximum": 1 },
    "mode_results": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/modeResult" }
    },
    "top_modes": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mode" }
    },
    "recommendation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/recommendation" }
      ]
    },
    "insufficient_evidence": { "type": "boolean" },
    "processing_time_ms": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "mode": {
      "type": "string",
      "enum": [
        "RULE_OF_THIRDS",
        "DYNAMIC_SYMMETRY",
        "BALANCED",
        "TRIANGLE",
        "DIAGONAL",
        "HORIZONTAL",
        "OBLIQUE",
        "CURVE",
        "RADIAL",
        "CHECKERBOARD",
        "CENTRIPETAL",
        "TUNNEL",
        "FRAME_WITHIN_FRAME",
        "CROSS",
        "VERTICAL"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p1", "p2"],
      "properties": {
        "p1": { "$ref": "#/$defs/point" },
        "p2": { "$ref": "#/$defs/point" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "strength", "description", "points", "lines", "contour"],
      "properties": {
        "evidence_type": {
          "type": "string",
          "enum": [
            "SUBJECT_POSITION",
            "SALIENCY_FOCUS",
            "LINE",
            "LINE_INTERSECTION",
            "CONTOUR",
            "NESTED_CONTOUR",
            "VANISHING_POINT",
            "VISUAL_MASS",
            "REPETITION",
            "SYMMETRY",
            "CURVATURE"
          ]
        },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
        "contour": { "type": "array", "items": { "$ref": "#/$defs/point" } }
      }
    },
    "modeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "match_score", "confidence", "evidence", "is_visible", "stable_for_ms"],
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "match_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "is_visible": { "type": "boolean" },
        "stable_for_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_mode",
        "action",
        "reason",
        "current_score",
        "projected_score",
        "adjustment_cost",
        "priority",
        "target_points",
        "aligned"
      ],
      "properties": {
        "target_mode": { "$ref": "#/$defs/mode" },
        "action": {
          "type": "string",
          "enum": [
            "MOVE_LEFT",
            "MOVE_RIGHT",
            "TILT_UP",
            "TILT_DOWN",
            "ROTATE_CLOCKWISE",
            "ROTATE_COUNTERCLOCKWISE",
            "MOVE_CLOSER",
            "MOVE_BACK",
            "KEEP"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "current_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "projected_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "adjustment_cost": { "type": "number", "minimum": 0, "maximum": 1 },
        "priority": { "type": "number", "minimum": 0, "maximum": 1 },
        "target_points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "aligned": { "type": "boolean" }
      }
    }
  }
}
